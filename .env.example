# =============================================================================
# .env.example — Environment Variable Template
# =============================================================================
# NEVER commit the real .env file. Copy this file to .env and fill in your
# actual values. The .env file is blocked by .gitignore and .bobignore.
#
# Setup steps:
#   1. cp .env.example .env      (Linux/macOS)
#      copy .env.example .env    (Windows)
#   2. Edit .env and replace every placeholder below with your real value.
#   3. Run: pip install -r requirements.txt
#   4. Run: python watsonx_mcp_server.py          (stdio mode — Bob IDE)
#      OR:  python watsonx_mcp_server.py --http   (HTTP mode — ngrok/Orchestrate)
# =============================================================================


# -----------------------------------------------------------------------------
# IBM_CLOUD_API_KEY
# How to get: IBM Cloud console -> Manage -> Access (IAM) -> API keys -> Create
# URL: https://cloud.ibm.com/iam/apikeys
# Format: a long alphanumeric string, e.g. "abc123XYZdefg..."
# Role: exchanged for a short-lived Bearer token at runtime via the IAM endpoint
# -----------------------------------------------------------------------------
IBM_CLOUD_API_KEY=your-ibm-cloud-api-key-here


# -----------------------------------------------------------------------------
# WATSONX_PROJECT_ID
# How to get: watsonx.ai -> Projects -> select project -> Manage -> General
# URL: https://dataplatform.cloud.ibm.com/wx/home
# Format: UUID, e.g. "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
# Role: scopes all model inference requests to your project for billing/access
# -----------------------------------------------------------------------------
WATSONX_PROJECT_ID=your-watsonx-project-uuid-here


# -----------------------------------------------------------------------------
# WATSONX_URL
# How to get: watsonx.ai -> Deployments tab, or use regional default below.
# Common values:
#   Dallas   (us-south): https://us-south.ml.cloud.ibm.com
#   Frankfurt (eu-de):   https://eu-de.ml.cloud.ibm.com
#   Tokyo    (jp-tok):   https://jp-tok.ml.cloud.ibm.com
#   London   (eu-gb):    https://eu-gb.ml.cloud.ibm.com
# Role: base URL for POST /ml/v1/text/generation
# -----------------------------------------------------------------------------
WATSONX_URL=https://us-south.ml.cloud.ibm.com
